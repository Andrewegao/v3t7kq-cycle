{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weatherx-model-scheduler",
  "account_id": "a89f9a1af485021fbc60a68b163c7c6e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["8-59/10 * * * *", "7 * * * *", "35 2,8,14,20 * * *", "23 */6 * * *", "52 9 * * *"]
  },
  "secrets": {
    "required": ["GITHUB_DISPATCH_TOKEN"]
  },
  "vars": {
    "GITHUB_OWNER": "Andrewegao",
    "GITHUB_REPO": "v3t7kq-cycle",
    "GITHUB_WORKFLOW": "catalog-bake.yml",
    "SATELLITE_GITHUB_WORKFLOW": "satellite-archive.yml",
    "BAKE_GITHUB_WORKFLOW": "bake.yml",
    "GLOFAS_GITHUB_WORKFLOW": "glofas-ingest.yml",
    "CAMS_GITHUB_WORKFLOW": "cams-ingest.yml",
    "GITHUB_REF": "main",
    "CATALOG_TARGET": "production"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
